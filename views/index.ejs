<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('partials/menu') %>
    <div id="work-area">
      <div class="panel">
        <img src="/images/placeholder-logo.jpg">
        <h1>Welcome to <%= title %>!</h1>
        <p>
          Critical thinking isn’t a talent; it’s a skill. And like any skill, it
          requires practice. Whether you are making business decisions or
          navigating daily life, Twistask provides the tools to solve and create
          complex issues and build bulletproof logic.
        </p>
      </div>

      <div class="panel" id="home-jump-in">
        <h2>Jump Right In</h2>
        <div id="home-stats"></div>
        <div id="featured-tasks"></div>
      </div>

      <div id="how-it-works">
        <h2>How It Works</h2>
        <div id="how-it-works-grid">
          <div class="feature-card">
            <h3>Solve Tasks</h3>
            <p>Browse the task directory and solve any challenge at your own pace &mdash; no account required.</p>
            <a href="/tasks">Browse Tasks &rarr;</a>
          </div>
          <div class="feature-card">
            <h3>Time Trial</h3>
            <p>Race the clock across a set of tasks and see how many you can solve before time runs out.</p>
            <a href="/timeTrial">Start a Trial &rarr;</a>
          </div>
          <div class="feature-card">
            <h3>Peer Review</h3>
            <p>Sign in to leave feedback on how others solved a task &mdash; and get feedback on your own.</p>
            <% if (auth) { %>
              <a href="/tasks">Browse Tasks &rarr;</a>
            <% } else { %>
              <a href="/auth/register">Create an Account &rarr;</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <script type="module" src="/javascripts/handlers/home.js"></script>
  </body>
  <%- include('partials/common') %>
</html>
