<link rel="stylesheet" href="/stylesheets/menu.css" />
<nav id="menu" role="navigation" aria-label="Main">
  <% if (mode !== "timeTrial") { %>
  <div id="common">
    <a href="/" id="home-link">Home</a>
    <a href="/timeTrial" id="timeTrial-link">Time Trial</a>
    <% if (auth) { %>
    <% if (user.role !== "student") { %>
      <a href="/editor" id="editor-link">Task Editor</a>
    <% } %>
    <% } %>
  </div>

  <div id="menu-right">
    <% if (!auth) { %>
    <div id="logged-out" data-access="guestOnly">
      <a href="/auth/register" id="register-link">Register</a>
      <a href="/auth/login" id="login-link">Login</a>
    </div>
    <% } else { %>
    <div id="logged-in" data-access="authOnly">
      <button
        type="button"
        id="user-menu-toggle"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="user-menu"
      >
        <%= user?.name %>
        <span aria-hidden="true">&#9662;</span>
      </button>
      <div id="user-menu" role="menu" aria-labelledby="user-menu-toggle" hidden>
        <label for="language-select">Language: </label><select id="language-select" role="menuitem">
          <option value="en">English</option>
          <option value="ru">Russian</option>
          <option value="cn">Chinese</option>
        </select>
        <a href="/users/profile" id="profile-link" role="menuitem">Profile</a>
        <a href="/users/settings" id="settings-link" role="menuitem">Settings</a>
        <a id="logout" role="menuitem" tabindex="0">Logout</a>
      </div>
    </div>
      <script type="module" src="/javascripts/handlers/menu/userMenuDropdown.js"></script>
      <script type="module" src="/javascripts/handlers/menu/menuSetup.js"></script>
    <% } %>
  </div>
    <% } %>
  <% if (mode === "timeTrial") { %>
  <div id="trial-menu">
    <a href="/" id="home-link" data-mode="home">Give Up</a>
  </div>
  <% } %>
</nav>


