<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/challenge.css' />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
</head>
<body>
    <%- include('menu') %>
    <div id="work-area">
        <div id="editor-area">
            <label for="author-name">Enter your username: </label>
            <input id="author-name" type="text">
            <label for="task-title">Enter the name of the task: </label>
            <input id="task-title" type="text">
            <div id="editor">
                <p>Type the contents of the task here. </p>
                <p><br /></p>
            </div>
            <button type="submit" id="submit">Submit</button>
        </div>
    </div>
    <script type="module" src="/javascripts/baseSetup.js"></script>
    <script type="module" src="/javascripts/editorSetup.js"></script>
</body>
</html>
