<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('../partials/menu') %>
    <div id="work-area">
      <h1 class="page-title">Register</h1>
      <form action="/auth/register" method="post">
        <label for="email">E-mail:</label><input type="email" id="email" name="email" required /><br />
        <label for="username">Username:</label><input type="text" id="username" name="name" required /><br />
        <label for="password">Password:</label><input type="password" id="password" name="password" minlength="8" required /><br />
        <label for="password_repeat">Confirm password:</label><input
          type="password"
          id="password_repeat"
          name="passwordConfirm"
          minlength="8"
          required
        /><br />
        <label for="student_type">I'm a student</label><input type="radio" id="student_type" name="role" value="student"><br>
        <label for="teacher_type">I'm a teacher</label><input type="radio" id="teacher_type" name="role" value="teacher"><br>
        <button type="submit" id="submit">Register</button><br /><br />
        <div id="error-box"><%= err %></div>
      </form>
    </div>
  </body>
  <%- include('../partials/common') %>
</html>
