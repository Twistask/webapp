<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('../partials/menu') %>
    <div id="work-area">
      <form action="/auth/login" method="post">
        <label for="email">E-mail:</label><input type="text" id="email" name="email" required /><br />
        <label for="password">Password:</label><input type="password" id="password" name="password" required /><br />
        <a href="/users/forgot-password">Forgot password?</a>
        <button type="submit" id="submit">Login</button>
        <div id="error-box"><%= err %></div>
      </form>
    </div>
  </body>
  <%- include('../partials/common') %>
</html>
