<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <%- include('partials/editor') %>
  </head>
  <body>
    <%- include('partials/menu') %>
    <div id="work-area">
      <div id="task-area">
        <div id="task-title"></div>
        <div id="viewer"></div>
      </div>
      <% if (mode === "review") { %>
      <div id="review-answer-area">
        <div id="answer-viewer"></div>
      </div>
      <% } %>
      <div id="answer-area">
        <% if (!auth && mode === "challenge") { %>
        <label for="author-name">Input your name:</label><input id="author-name" type="text" />
        <% } %>
        <div id="editor">
          <p>Type here.</p>
          <p><br /></p>
        </div>
        <button type="submit" id="submit">Submit</button>
      </div>
    </div>
    <% if (mode === "timeTrial") { %>
    <script>
      window.TRIAL = <%- JSON.stringify(trial || {}).replace(/</g, "\\u003c") %>;
      window.AUTHOR = <%- JSON.stringify(author || "").replace(/</g, "\\u003c") %>;
    </script>
    <script type="module" src="/javascripts/handlers/modes/trialControls.js"></script>
    <% } %>
    <% if (mode === "challenge") { %>
      <script>
        window.CHALLENGE = <%- JSON.stringify({
          task: task || {},
        }).replace(/</g, "\\u003c") %>;
      </script>
      <script type="module" src="/javascripts/handlers/modes/challengeControls.js"></script>
    <% } %>
    <% if (mode === "review") { %>
      <script>
        window.REVIEW = <%- JSON.stringify({
          answer: answer || {},
        }).replace(/</g, "\\u003c") %>;
      </script>
      <script type="module" src="/javascripts/handlers/modes/reviewControls.js"></script>
    <% } %>
  </body>
  <%- include('partials/common') %>
</html>
