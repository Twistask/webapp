<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <%- include('partials/styling') %>
    <%- include('partials/editor') %>
  </head>
  <body>
    <%- include('partials/menu') %>
    <div id="work-area">
      <% if (mode === "challenge") { %>
      <div id="controls">
        <label for="challenge-select">Select a challenge:</label>
        <select id="challenge-select"></select>
      </div>
      <% } %>
      <div id="task-area">
        <div id="viewer"></div>
      </div>
      <% if (mode === "review") { %>
      <div id="review-answer-area">
        <div id="answer-viewer"></div>
      </div>
      <% } %>
      <div id="answer-area">
        <% if (!auth && mode === "challenge") { %>
        <label for="author-name">Input your name: </label>
        <input id="author-name" type="text" />
        <% } %>
        <% if (mode === "review") { %>
        <label for="review-grade">Select a grade (0-100): </label>
        <input id="review-grade" type="number" min="0" max="100" value="0" />
        <% } %>
        <div id="editor">
          <p>Type here.</p>
          <p><br /></p>
        </div>
        <button type="submit" id="submit">Submit</button>
      </div>
    </div>
    <script>
      window.APP = {
          tasks: <%- JSON.stringify(tasks || []) %>,
          answers: <%- JSON.stringify(answers || []) %>,
          mode: "<%- mode %>",
      };
    </script>
    <% if (mode === "timeTrial") { %>
    <script>
      window.TRIAL = <%- JSON.stringify(trial || {}) %>
              window.AUTHOR = "<%- author %>"
    </script>
    <script type="module" src="/javascripts/handlers/modes/trialControls.js"></script>
    <% } %>
    <% if (mode === "challenge") { %>
      <script type="module" src="/javascripts/handlers/modes/challengeControls.js"></script>
    <% } %>
    <% if (mode === "review") { %>
      <script type="module" src="/javascripts/handlers/modes/reviewControls.js"></script>
    <% } %>
    <script type="module" src="/javascripts/baseSetup.js"></script>
  </body>
</html>
