<!DOCTYPE html>
<html>
  <head>
    <title><%= title || 'Twistask' %></title>
    <%- include('partials/editor') %>
  </head>
  <body>
    <%- include('partials/menu') %>
    <div id="work-area">
      <% if (mode === "challenge") { %>
      <div id="controls">
        <label for="challenge-select">Select a challenge:</label>
        <select id="challenge-select" name="challenge-select" aria-label="Select a challenge"></select>
      </div>
      <% } %>
      <div id="task-area">
        <div id="viewer" aria-live="polite"></div>
      </div>
      <% if (mode === "review") { %>
      <div id="review-answer-area">
        <div id="answer-viewer" aria-live="polite"></div>
      </div>
      <% } %>
      <div id="answer-area">
        <% if (!auth && mode === "challenge") { %>
        <label for="author-name">Input your name: </label>
        <input id="author-name" name="author" type="text" autocomplete="name" />
        <% } %>
        <div id="editor" role="textbox" contenteditable="true" aria-label="Answer editor">
          <p>Type here.</p>
          <p><br /></p>
        </div>
        <button type="button" id="submit">Submit</button>
      </div>
    </div>
    <% if (mode === "timeTrial") { %>
    <script>
      // Safely embed trial data and author into JS context. Escape '<' to avoid breaking <script>.
      window.TRIAL = <%- JSON.stringify(trial || {}).replace(/</g, "\\u003c") %>;
      window.AUTHOR = <%- JSON.stringify(String(author || "")).replace(/</g, "\\u003c") %>;
    </script>
    <script type="module" src="/javascripts/handlers/modes/trialControls.js"></script>
    <% } %>
    <% if (mode === "challenge") { %>
      <script type="module" src="/javascripts/handlers/modes/challengeControls.js"></script>
    <% } %>
    <% if (mode === "review") { %>
      <script type="module" src="/javascripts/handlers/modes/reviewControls.js"></script>
    <% } %>
  </body>
  <%- include('partials/common') %>
</html>
