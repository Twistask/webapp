<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('../partials/menu') %>
    <div id="work-area">
      <form action="/timeTrial" method="post">
        <h1 class="page-title">Trial Mode</h1>
        <label for="difficulty">Select your difficulty:</label><select name="difficulty" id="difficulty">
          <option value="easy">Easy</option>
          <option value="medium">Medium</option>
          <option value="hard">Hard</option>
          <option value="superHard">Super Hard</option>
        </select><br>
        <% if (!auth) { %>
          <label for="username">Enter your name:</label><input type="text" id="username" name="author" required><br>
        <% } %>
        <button type="submit" id="startTrial">Start</button>
      </form>
    </div>
  </body>
  <%- include('../partials/common') %>
</html>
