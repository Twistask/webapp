<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('../partials/menu') %>
    <div id="work-area">
      <h1 class="page-title" data-i18n="nav.login"><%= t('nav.login') %></h1>
      <form action="/auth/login" method="post">
        <label for="email" data-i18n="auth.emailLabel"><%= t('auth.emailLabel') %></label><input type="text" id="email" name="email" required /><br />
        <label for="password" data-i18n="auth.passwordLabel"><%= t('auth.passwordLabel') %></label><input type="password" id="password" name="password" required /><br />
        <a href="/auth/forgot-password" data-i18n="auth.forgotPassword"><%= t('auth.forgotPassword') %></a>
        <button type="submit" id="submit" data-i18n="nav.login"><%= t('nav.login') %></button>
        <div id="error-box"><%= err %></div>
      </form>
    </div>
  </body>
  <%- include('../partials/common') %>
</html>
