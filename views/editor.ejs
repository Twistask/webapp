<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <%- include('partials/editor') %>
  </head>
  <body>
    <%- include('partials/menu') %>
    <div id="work-area">
      <div id="controls">
        <label for="challenge-select">Select a challenge:</label>
        <select id="challenge-select">
          <option value="new">New Task</option>
        </select>
        <br />
        <label for="task-title">Enter the name of the task: </label>
        <input id="task-title" type="text" /><br>
        <label for="task-language">Select the language: </label>
        <select id="task-language">
          <option value="en">English</option>
          <option value="ru">Russian</option>
          <option value="cn">Chinese</option>
        </select>
      </div>
      <div id="editor-area">
        <div id="editor">
          <p>Type the contents of the task here.</p>
          <p><br /></p>
        </div>
        <div id="import-row">
          <label for="markdown-import">Import from Markdown:</label>
          <input type="file" id="markdown-import" accept=".md,.txt" />
        </div>
        <button type="submit" id="submit">Submit</button>
        <button id="delete">Delete</button>
      </div>
    </div>
    <script type="module" src="/javascripts/handlers/modes/editorControls.js"></script>
  </body>
  <%- include('partials/common') %>
</html>
