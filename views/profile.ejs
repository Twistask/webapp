<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('partials/menu') %>
    <div id="work-area">
      <% if (user.role !== "student") { %>
        <div id="my-tasks" class="panel">
          <h1>My Tasks</h1>
        </div>
      <% } %>
      <div id="my-answers" class="panel">
        <h1>My Answers</h1>
      </div>
      <div id="my-reviews" class="panel">
        <h1>My Reviews</h1>
      </div>
    </div>
    <script
      type="module"
      src="/javascripts/handlers/users/profileHandler.js"
    ></script>
  </body>
  <%- include('partials/common') %>
</html>
