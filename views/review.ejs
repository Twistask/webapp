<!DOCTYPE html>
<html>
<head>
    <title><%= title %> - Review Mode</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/challenge.css' />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
</head>
<body>
    <%- include('menu') %>
    <div id="work-area">
        <div id="task-area">
            The task goes here.
        </div>
        <div id="answer-area">
            The random answer goes here.
        </div>
        <div id="review-area">
            <label for="grade">Select a grade (0-100): </label>
            <input id="grade" type="number" min="0" max="100" value="0">
            <div id="editor">
                <p>Type your review here. </p>
                <p><br /></p>
            </div>
            <button type="submit" id="submit">Submit</button>
        </div>
    </div>
    <% if (tasks && tasks.length) { %>
        <script src="/javascripts/challengeHandler.js" type="module"></script>
        <script type="module">
            const quill = new Quill('#editor', {
                theme: 'snow'
            });
            const tasks = <%- JSON.stringify(tasks) %>;
            const answers = <%- JSON.stringify(answers) %>;
            let chosenAnswer;

            function setTask() {
                const answersForTask = answers.filter(a => a.answer_text && a.answer_text.trim() !== '');
                if (!answersForTask.length || !tasks.length) {
                    console.warn('no answers or tasks available');
                    return;
                }

                const randIndex = Math.floor(Math.random() * answersForTask.length);
                chosenAnswer = answersForTask[randIndex];
                const task = tasks.find(t => t.id === chosenAnswer.task_id);

                if (!task) {
                    console.warn('no matching task for answer', chosenAnswer);
                    return;
                }

                // If description is plain text use textContent; if it contains HTML (e.g. Quill output) sanitize then set innerHTML
                document.getElementById('task-area').innerHTML = task.description;
                document.getElementById('answer-area').innerHTML = chosenAnswer.answer_text;
            }
            setTask();
            document.getElementById("submit").addEventListener("click", async () => {
                let sound = new Audio()
                sound.src = "../sounds/emblem.wav";
                document.body.appendChild(sound);
                sound.volume = 0.5;
                await sound.play();
                const res = await fetch('/review/submit', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        "answer_id": chosenAnswer.id,
                        "grade": document.getElementById("grade").value,
                        "comment_text": quill.getSemanticHTML()
                    })
                });
            })
        </script>
    <% } %>
</body>
</html>
