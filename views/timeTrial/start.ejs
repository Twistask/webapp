<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('../partials/menu') %>
    <div id="work-area">
      <form action="/timeTrial" method="post">
        <h1 class="page-title" data-i18n="nav.trialMode"><%= t('nav.trialMode') %></h1>
        <label for="difficulty" data-i18n="trial.selectDifficulty"><%= t('trial.selectDifficulty') %></label><select name="difficulty" id="difficulty">
          <option value="easy" data-i18n="common.difficulty.easy"><%= t('common.difficulty.easy') %></option>
          <option value="medium" data-i18n="common.difficulty.medium"><%= t('common.difficulty.medium') %></option>
          <option value="hard" data-i18n="common.difficulty.hard"><%= t('common.difficulty.hard') %></option>
          <option value="superHard" data-i18n="common.difficulty.superHard"><%= t('common.difficulty.superHard') %></option>
        </select><br>
        <% if (!auth) { %>
          <label for="username" data-i18n="trial.enterName"><%= t('trial.enterName') %></label><input type="text" id="username" name="author" required><br>
        <% } %>
        <button type="submit" id="startTrial" data-i18n="trial.start"><%= t('trial.start') %></button>
      </form>
    </div>
  </body>
  <%- include('../partials/common') %>
</html>
