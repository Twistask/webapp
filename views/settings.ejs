<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
<%- include('partials/menu') %>
<div id="work-area">
    <div id="user-settings">
        <h1 class="page-title" data-i18n="settings.title"><%= t('settings.title') %></h1>
        <form id="language-change" action="/users/settings" method="post">
            <h2 data-i18n="settings.languageSettings"><%= t('settings.languageSettings') %></h2>
            <!-- Distinct id from the nav's #language-select (partials/menu.ejs):
                 that one only sets this session's task-language filter, this
                 one persists your account's saved preference. Sharing an id
                 with the nav's select (as this used to) broke this label's
                 for-association, since the nav's select comes first in the
                 document and getElementById/label "for" both resolve to the
                 first match. -->
            <label for="account-language-select" data-i18n="settings.selectMainLanguage"><%= t('settings.selectMainLanguage') %></label><select id="account-language-select" name="language">
                <option value="en" data-i18n="common.lang.en"><%= t('common.lang.en') %></option>
                <option value="ru" data-i18n="common.lang.ru"><%= t('common.lang.ru') %></option>
                <option value="cn" data-i18n="common.lang.cn"><%= t('common.lang.cn') %></option>
            </select>
            <button type="submit" id="submit_lng" data-i18n="settings.confirm"><%= t('settings.confirm') %></button><br />
        </form>
        <form id="password-change" action="/users/settings" method="post">
            <h2 data-i18n="settings.securitySettings"><%= t('settings.securitySettings') %></h2>
            <label for="old_password" data-i18n="settings.currentPassword"><%= t('settings.currentPassword') %></label><input type="password" id="old_password" name="oldPassword" required /><br />
            <label for="password" data-i18n="settings.newPassword"><%= t('settings.newPassword') %></label><input type="password" id="password" name="password" required /><br />
            <label for="password_repeat" data-i18n="settings.confirmNewPassword"><%= t('settings.confirmNewPassword') %></label><input type="password" id="password_repeat" name="passwordConfirm" required /><br />
            <button type="submit" id="submit_pw" data-i18n="settings.changePassword"><%= t('settings.changePassword') %></button><br />
            <div id="error-box"><%= err %></div>
            <button type="button" id="delete_account" data-i18n="settings.deleteAccount"><%= t('settings.deleteAccount') %></button>
        </form>
    </div>
</div>
<script
        type="module"
        src="/javascripts/handlers/users/settingsHandler.js"
></script>
</body>
<%- include('partials/common') %>
</html>
