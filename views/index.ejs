<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('partials/menu') %>
    <div id="work-area">
      <h1 class="page-title">Welcome to <%= title %>!</h1>
      <div class="panel">
        <p>
          Critical thinking isn’t a talent; it’s a skill. And like any skill, it
          requires practice. Whether you are making business decisions or
          navigating daily life, Twistask provides the tools to solve and create
          complex issues and build bulletproof logic.
        </p>
      </div>

      <div class="panel" id="home-jump-in">
        <h2 class="page-title">Jump Right In</h2>
        <div id="home-stats"></div>
        <div id="featured-tasks"></div>
      </div>

      <div id="how-it-works">
        <h2 class="page-title">How It Works</h2>
        <div id="how-it-works-grid">
          <div class="feature-card">
            <h3>Solve Tasks</h3>
            <p>Browse the tasks and solve any challenge at your own pace!</p>
            <a href="/tasks">Browse Tasks</a>
          </div>
          <div class="feature-card">
            <h3>Trial Mode</h3>
            <p>Solve a set of tasks before the time runs out! Try the Super Hard mode for an extra challenge!</p>
            <a href="/timeTrial">Start Trial</a>
          </div>
          <div class="feature-card">
            <h3>Peer Review</h3>
            <p>Sign in to leave feedback on how others solved your tasks and get feedback on your own.</p>
            <% if (auth) { %>
              <a href="/users/profile">Check out Your Profile</a>
            <% } else { %>
              <a href="/auth/register">Create an Account &rarr;</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <script type="module" src="/javascripts/handlers/home.js"></script>
  </body>
  <%- include('partials/common') %>
</html>
