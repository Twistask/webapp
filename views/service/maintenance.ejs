<!DOCTYPE html>

<head>
  <title>Welcome!</title>
  <meta
    name="viewport"
    content="width=device-width, height=device-height, initial-scale=1"
  />
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      document.getElementById("welcome").innerHTML = "Website unavailable";
      document.getElementById("prompt").innerHTML =
        "The website is currently unavailable. Please try again later.";
    });
  </script>
</head>
<body>
  <style>
    body {
      display: grid;
      height: 100vh;
      margin: 0;
      background: linear-gradient(180deg, #ffffff 0%, #bbdefb 100%);
    }
    p {
      width: auto;
      height: auto;
      font-size: xx-large;
      font-family: "Segoe UI", system-ui;
      text-align: center;
      color: #0d47a1;
    }

    h1 {
      font-family: "Segoe UI", system-ui;
      font-size: xxx-large;
      text-align: center;
      color: #1e88e5;
    }
  </style>
  <h1 id="welcome"></h1>
  <p id="prompt"></p>
</body>
