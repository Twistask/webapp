<!DOCTYPE html>
<html>
  <head>
    <title><%= title || 'Twistask' %></title>
  </head>
  <body>
    <%- include('../partials/menu') %>
    <div id="work-area">
      <form action="/users/forgot-password" method="post">
        <label for="email">E-mail: </label>
        <input type="email" id="email" name="email" required autocomplete="email" /><br />
        <button type="submit" id="submit">Request Password Reset</button><br /><br />
        <div id="error-box"><%= err || '' %></div>
      </form>
    </div>
  </body>
  <%- include('../partials/common') %>
</html>
