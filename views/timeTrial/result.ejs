<!DOCTYPE html>
<html>
  <head>
    <title><%= title || 'Twistask' %></title>
  </head>
  <body>
    <%- include('../partials/menu') %>
    <div id="work-area">
      <h1><%= title || 'Time Trial Results' %></h1>
      <p>Trial Completed!</p>
      <button type="button" id="play-sound">Play completion sound</button>
    </div>
    <script>
      (function(){
        const soundUrl = '/sounds/trial_clear.mp3';
        const btn = document.getElementById('play-sound');
        if (!btn) return;
        const sound = new Audio(soundUrl);
        btn.addEventListener('click', async () => {
          try {
            await sound.play();
          } catch (err) {
            console.warn('Audio playback failed:', err);
            // If playback is blocked, inform the user gently
            btn.textContent = 'Play sound (click again if blocked)';
          }
        });
      })();
    </script>
    <%- include('../partials/common') %>
  </body>
</html>
