<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <%- include('../partials/styling') %>
  </head>
  <body>
    <%- include('../partials/menu') %>
    <div id="work-area">
      <form action="/timeTrial/start" method="post">
        <label>How many tasks would you like to solve?
          <input type="number" min="1" max="<%= tasks.length %>" value="1" name="tasksAmount">
        </label><br>
        <label>Select your difficulty:
          <select name="difficulty">
            <option value="easy">Easy</option>
            <option value="medium">Medium</option>
            <option value="hard">Hard</option>
            <option value="superHard">Super Hard</option>
          </select>
        </label><br>
        <button type="submit" id="startTrial">Start</button>
      </form>
    </div>
  </body>
</html>
