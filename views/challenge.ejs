<!DOCTYPE html>
<html>
<head>
    <title><%= title %> - Challenge Mode</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/challenge.css' />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
</head>
<body>
    <%- include('menu') %>
    <%- include('trial-menu') %>
    <div id="work-area">
        <div id="controls">
            <label for="challenge-select">Select a challenge:</label>
            <select id="challenge-select"></select>
        </div>
        <div id="task-area">
            The task goes here.
        </div>
        <div id="answer-area">
            <div id="editor">
                <p>Type your answer here. </p>
                <p><br /></p>
            </div>
            <button type="submit" id="submit">Submit</button>
        </div>
    </div>
    <% if (tasks && tasks.length) { %>
        <script src="/javascripts/challengeHandler.js" type="module"></script>
        <script type="module">
            const quill = new Quill('#editor', {
                theme: 'snow'
            });
            // inject server-side JS object into client as real JS
            import {createItems} from "/javascripts/challengeHandler.js";

            const tasks = <%- JSON.stringify(tasks) %>;
            createItems(tasks);
            async function setTask () {
                const value = document.getElementById("challenge-select").value;
                const task = tasks.find(t => t.id === value); // task is object or undefined
                document.getElementById("task-area").innerHTML = task.description;
            };
            document.getElementById("challenge-select").onchange = setTask;
            setTask();
            document.getElementById("submit").addEventListener("click", async () => {
                let sound = new Audio()
                sound.src = "../sounds/emblem.wav";
                document.body.appendChild(sound);
                sound.volume = 0.5;
                await sound.play();
                const res = await fetch('/challenge/submit', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        "task_id": document.getElementById("challenge-select").value,
                        "answer_text": quill.getText()
                    })
                });
            })
        </script>
    <% } %>
<% if (timed) { %>
    <script type="module" src="/javascripts/trialHandler.js"></script>
<% } %>
</body>
</html>
