<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <%- include('../partials/menu') %>
    <div id="work-area">
      <form action="/auth/reset-password" method="post">
        <input type="password" id="token" name="token" value="<%= token %>" required hidden />
        <label for="password" data-i18n="auth.passwordLabel"><%= t('auth.passwordLabel') %></label><input type="password" id="password" name="password" minlength="8" required /><br />
        <label for="password_repeat" data-i18n="auth.confirmPasswordLabel"><%= t('auth.confirmPasswordLabel') %></label><input
          type="password"
          id="password_repeat"
          name="passwordConfirm"
          minlength="8"
          required
        /><br />
        <button type="submit" id="submit" data-i18n="auth.resetPassword"><%= t('auth.resetPassword') %></button><br /><br />
      </form>
    </div>
  </body>
  <%- include('../partials/common') %>
</html>
